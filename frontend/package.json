{
  "name": "circuits-llm-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "gen:api": "openapi-typescript openapi.json -o src/api/schema.d.ts",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "tsc -b && vite build",
    "build:embed": "npm run build && node scripts/embed.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "5.59.20",
    "elkjs": "0.9.3",
    "mermaid": "11.4.0",
    "openapi-fetch": "0.13.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "9.0.1",
    "remark-gfm": "4.0.0",
    "uplot": "1.6.31"
  },
  "devDependencies": {
    "@eslint/js": "9.14.0",
    "@tailwindcss/vite": "^4.1.4",
    "@types/node": "^22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "eslint": "9.14.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "globals": "15.12.0",
    "openapi-typescript": "7.4.3",
    "tailwindcss": "^4.1.4",
    "typescript": "5.6.3",
    "typescript-eslint": "8.14.0",
    "vite": "5.4.11",
    "vitest": "2.1.5"
  }
}
